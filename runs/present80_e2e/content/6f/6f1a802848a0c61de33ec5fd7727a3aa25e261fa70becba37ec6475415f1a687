# rationale: These assertions operate on (stim, observed) trace data where stim contains input signals
# rationale: and observed contains output signals sampled each cycle. Since we only have external
# rationale: port visibility (clk, rst_n, load_en, din, shift_out_en, dout, done), we must infer
# rationale: internal state (key_reg, state, fsm_state, load_cnt, round) from the stimulus sequence.
# rationale: For test_vector_correctness and encrypt_round_sequence we implement the full PRESENT-80
# rationale: cipher in Python to cross-check. For purely observable invariants we check dout/done
# rationale: against expected values derived from the stimulus trace.
# rationale: The stim list contains dicts with keys: clk, rst_n, load_en, din, shift_out_en
# rationale: The observed list contains dicts with keys: dout, done
# rationale: We detect rising clock edges by looking at consecutive stim entries where clk goes 0->1,
# rationale: but since the trace may already be sampled at rising edges only, we treat each entry
# rationale: as one rising-edge sample unless clk is explicitly tracked.

def _get(d, key, default=0):
    return d.get(key, default)


def _rising_edges(stim):
    """Return indices of rising clock edges (clk transitions 0->1, or all if clk always 1)."""
    edges = []
    prev_clk = 0
    for i, s in enumerate(stim):
        clk = _get(s, 'clk', 1)
        if clk == 1 and prev_clk == 0:
            edges.append(i)
        prev_clk = clk
    # If no transitions found (clk always 1 or always 0), treat every cycle as an edge
    if not edges:
        edges = list(range(len(stim)))
    return edges


# PRESENT-80 reference implementation

SBOX = [0x2, 0x1, 0x7, 0x4, 0x8, 0xF, 0xE, 0x3,
        0xD, 0xA, 0x0, 0x9, 0xB, 0x6, 0x5, 0xC]

SBOX_INV = [SBOX.index(i) for i in range(16)]


def _sbox_layer(state64):
    result = 0
    for nibble in range(16):
        s = (state64 >> (nibble * 4)) & 0xF
        result |= SBOX[s] << (nibble * 4)
    return result & 0xFFFFFFFFFFFFFFFF


def _player(state64):
    result = 0
    for i in range(63):
        bit = (state64 >> i) & 1
        p = (i * 16) % 63
        result |= bit << p
    # bit 63 stays at 63
    bit63 = (state64 >> 63) & 1
    result |= bit63 << 63
    return result & 0xFFFFFFFFFFFFFFFF


def _key_schedule(key80, round_num):
    # Rotate left by 61 bits (= rotate right by 19)
    k = key80 & ((1 << 80) - 1)
    rotated = ((k << 61) | (k >> 19)) & ((1 << 80) - 1)
    # Apply S-box to top nibble (bits [79:76])
    top_nibble = (rotated >> 76) & 0xF
    rotated = (rotated & ~(0xF << 76)) | (SBOX[top_nibble] << 76)
    # XOR round counter into bits [19:15]
    rotated ^= (round_num & 0x1F) << 15
    return rotated & ((1 << 80) - 1)


def _present80_encrypt(key80, plaintext64):
    state = plaintext64 & 0xFFFFFFFFFFFFFFFF
    key = key80 & ((1 << 80) - 1)
    for r in range(1, 32):
        # addRoundKey
        state ^= (key >> 16) & 0xFFFFFFFFFFFFFFFF
        # sBoxLayer
        state = _sbox_layer(state)
        # pLayer
        state = _player(state)
        # key schedule
        key = _key_schedule(key, r)
    # final addRoundKey
    state ^= (key >> 16) & 0xFFFFFFFFFFFFFFFF
    return state


def _simulate_fsm(stim, observed):
    """
    Simulate the PRESENT-80 FSM from the stimulus trace.
    Returns a list of per-rising-edge dicts with inferred internal state.
    """
    edges = _rising_edges(stim)
    # FSM states
    FSM_LOAD = 0
    FSM_ENCRYPT = 1
    FSM_DONE = 2

    fsm_state = FSM_LOAD
    key_reg = 0
    state64 = 0
    load_cnt = 0
    round_num = 0
    done_flag = 0
    shift_reg = 0  # 144-bit combined {key_reg[79:0], state[63:0]}

    records = []

    for idx in edges:
        s = stim[idx]
        rst_n = _get(s, 'rst_n', 1)
        load_en = _get(s, 'load_en', 0)
        din = _get(s, 'din', 0)
        shift_out_en = _get(s, 'shift_out_en', 0)

        # Async reset takes priority (we model it as synchronous here since
        # we only have cycle-level data, but flag it)
        if rst_n == 0:
            fsm_state = FSM_LOAD
            key_reg = 0
            state64 = 0
            load_cnt = 0
            round_num = 0
            done_flag = 0
            records.append({
                'idx': idx,
                'fsm_state': fsm_state,
                'key_reg': key_reg,
                'state': state64,
                'load_cnt': load_cnt,
                'round': round_num,
                'done': done_flag,
                'rst_n': rst_n,
                'load_en': load_en,
                'din': din,
                'shift_out_en': shift_out_en,
            })
            continue

        if fsm_state == FSM_LOAD:
            if load_en:
                # Shift in one bit MSB-first into 144-bit register
                # {key_reg[79:0], state[63:0]} shifts left, din at bit 0
                combined = ((key_reg << 64) | state64) & ((1 << 144) - 1)
                combined = ((combined << 1) | din) & ((1 << 144) - 1)
                key_reg = (combined >> 64) & ((1 << 80) - 1)
                state64 = combined & 0xFFFFFFFFFFFFFFFF
                load_cnt += 1
                if load_cnt == 144:
                    fsm_state = FSM_ENCRYPT
                    round_num = 1

        elif fsm_state == FSM_ENCRYPT:
            # Apply one round
            # addRoundKey
            state64 ^= (key_reg >> 16) & 0xFFFFFFFFFFFFFFFF
            # sBoxLayer
            state64 = _sbox_layer(state64)
            # pLayer
            state64 = _player(state64)
            # key schedule
            key_reg = _key_schedule(key_reg, round_num)

            if round_num == 31:
                # Next edge will be final addRoundKey
                # Actually per contract: after round 31 key schedule update,
                # one additional edge applies final addRoundKey
                # So we stay in ENCRYPT for one more edge
                round_num = 32  # sentinel: final addRoundKey pending
            elif round_num == 32:
                # This shouldn't happen here; handled below
                pass
            else:
                round_num += 1

            # Check if we just finished round 31 (round_num was 31 before increment)
            # Actually re-read: round_num==32 means we need final addRoundKey next edge
            # But we set round_num=32 after processing round 31 above.
            # The final addRoundKey happens on the NEXT edge in ENCRYPT state.
            # Let's re-check: contract says "On the clock edge immediately following the 31st round edge"
            # So round 31 edge: apply round ops, set round_num=32
            # Next edge (round_num==32): apply final addRoundKey, set done=1, go to DONE

            if round_num == 32:
                # We just processed round 31; next edge is final addRoundKey
                # But we already incremented round_num to 32 above
                # The final addRoundKey will happen on the next iteration
                pass

        elif fsm_state == FSM_DONE:
            if load_en:
                # Restart load
                fsm_state = FSM_LOAD
                done_flag = 0
                load_cnt = 0
                key_reg = 0
                state64 = 0
                round_num = 0
            elif shift_out_en and done_flag:
                # Shift state left, state[0] gets 0
                state64 = (state64 << 1) & 0xFFFFFFFFFFFFFFFF

        records.append({
            'idx': idx,
            'fsm_state': fsm_state,
            'key_reg': key_reg,
            'state': state64,
            'load_cnt': load_cnt,
            'round': round_num,
            'done': done_flag,
            'rst_n': rst_n,
            'load_en': load_en,
            'din': din,
            'shift_out_en': shift_out_en,
        })

    return records


def _simulate_fsm_v2(stim):
    """
    More careful simulation that properly handles the final addRoundKey edge
    and done flag. Returns list of per-rising-edge state snapshots AFTER
    the edge's operations, plus 'pre_state' for before.
    """
    edges = _rising_edges(stim)

    FSM_LOAD = 0
    FSM_ENCRYPT = 1
    FSM_FINAL = 2   # one extra edge for final addRoundKey
    FSM_DONE = 3

    fsm_state = FSM_LOAD
    key_reg = 0
    state64 = 0
    load_cnt = 0
    round_num = 0
    done_flag = 0

    records = []

    for idx in edges:
        s = stim[idx]
        rst_n = _get(s, 'rst_n', 1)
        load_en = _get(s, 'load_en', 0)
        din = _get(s, 'din', 0)
        shift_out_en = _get(s, 'shift_out_en', 0)

        pre = {
            'fsm_state': fsm_state,
            'key_reg': key_reg,
            'state': state64,
            'load_cnt': load_cnt,
            'round': round_num,
            'done': done_flag,
        }

        if rst_n == 0:
            fsm_state = FSM_LOAD
            key_reg = 0
            state64 = 0
            load_cnt = 0
            round_num = 0
            done_flag = 0
        else:
            if fsm_state == FSM_LOAD:
                if load_en:
                    combined = ((key_reg << 64) | state64) & ((1 << 144) - 1)
                    combined = ((combined << 1) | din) & ((1 << 144) - 1)
                    key_reg = (combined >> 64) & ((1 << 80) - 1)
                    state64 = combined & 0xFFFFFFFFFFFFFFFF
                    load_cnt += 1
                    if load_cnt == 144:
                        fsm_state = FSM_ENCRYPT
                        round_num = 1

            elif fsm_state == FSM_ENCRYPT:
                # addRoundKey
                state64 ^= (key_reg >> 16) & 0xFFFFFFFFFFFFFFFF
                # sBoxLayer
                state64 = _sbox_layer(state64)
                # pLayer
                state64 = _player(state64)
                # key schedule
                key_reg = _key_schedule(key_reg, round_num)

                if round_num == 31:
                    fsm_state = FSM_FINAL
                else:
                    round_num += 1

            elif fsm_state == FSM_FINAL:
                # Final addRoundKey
                state64 ^= (key_reg >> 16) & 0xFFFFFFFFFFFFFFFF
                done_flag = 1
                fsm_state = FSM_DONE

            elif fsm_state == FSM_DONE:
                if load_en:
                    fsm_state = FSM_LOAD
                    done_flag = 0
                    load_cnt = 0
                    key_reg = 0
                    state64 = 0
                    round_num = 0
                elif shift_out_en and done_flag:
                    state64 = (state64 << 1) & 0xFFFFFFFFFFFFFFFF

        records.append({
            'idx': idx,
            'pre': pre,
            'fsm_state': fsm_state,
            'key_reg': key_reg,
            'state': state64,
            'load_cnt': load_cnt,
            'round': round_num,
            'done': done_flag,
            'rst_n': rst_n,
            'load_en': load_en,
            'din': din,
            'shift_out_en': shift_out_en,
        })

    return records


def assert_load_shift_order(args):
    """
    During LOAD phase, each rising edge with load_en high shifts one bit MSB-first
    into the 144-bit shift register {key_reg[79:0], state[63:0]}. The first bit
    received becomes key_reg[79] (MSB of key) and the 144th bit received becomes
    state[0] (LSB of plaintext).
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)

    FSM_LOAD = 0
    load_edges = [(r, i) for i, r in enumerate(records)
                  if r['pre']['fsm_state'] == FSM_LOAD and r['load_en'] == 1 and r['rst_n'] == 1]

    if not load_edges:
        return (True, "No LOAD-phase load_en edges found; invariant vacuously satisfied")

    # Check that after each load edge, the shift register advanced correctly
    # We verify by re-simulating and checking the combined register value
    # after each bit. We track the bits received in order.
    bits_received = []
    prev_combined = 0  # before any bits loaded
    prev_key = 0
    prev_state = 0

    for r, rec_idx in load_edges:
        pre = r['pre']
        pre_combined = ((pre['key_reg'] << 64) | pre['state']) & ((1 << 144) - 1)
        expected_combined = ((pre_combined << 1) | r['din']) & ((1 << 144) - 1)
        post_combined = ((r['key_reg'] << 64) | r['state']) & ((1 << 144) - 1)

        if post_combined != expected_combined:
            return (False,
                    f"Cycle {r['idx']}: load_shift_order violated. "
                    f"Expected combined=0x{expected_combined:036x}, "
                    f"got 0x{post_combined:036x} (din={r['din']})")

        bits_received.append(r['din'])

    # Verify MSB-first ordering: first bit should end up at key_reg[79]
    # after all 144 bits are loaded
    if len(bits_received) >= 144:
        expected_key = 0
        expected_pt = 0
        for i, b in enumerate(bits_received[:80]):
            expected_key = (expected_key << 1) | b
        for i, b in enumerate(bits_received[80:144]):
            expected_pt = (expected_pt << 1) | b

        # Find the record after 144th bit
        final_load_rec = None
        for r, rec_idx in load_edges:
            if r['load_cnt'] == 144:
                final_load_rec = r
                break

        if final_load_rec is not None:
            if final_load_rec['key_reg'] != expected_key:
                return (False,
                        f"After 144 bits: key_reg=0x{final_load_rec['key_reg']:020x} "
                        f"expected 0x{expected_key:020x}")
            if final_load_rec['state'] != expected_pt:
                return (False,
                        f"After 144 bits: state=0x{final_load_rec['state']:016x} "
                        f"expected 0x{expected_pt:016x}")

    return (True, f"load_shift_order verified across {len(load_edges)} load edges")


def assert_encrypt_auto_start(args):
    """
    Encryption begins automatically on the clock edge that accepts the 144th serial bit.
    When load_cnt reaches 144 on a rising edge with load_en high, the FSM transitions
    from LOAD to ENCRYPT on that same edge without requiring any additional control signal;
    round counter is initialised to 1.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_LOAD = 0
    FSM_ENCRYPT = 1

    for r in records:
        if r['pre']['fsm_state'] == FSM_LOAD and r['load_en'] == 1 and r['rst_n'] == 1:
            if r['load_cnt'] == 144:
                # Should have transitioned to ENCRYPT
                if r['fsm_state'] != FSM_ENCRYPT:
                    return (False,
                            f"Cycle {r['idx']}: After 144th bit loaded, FSM should be ENCRYPT "
                            f"but got {r['fsm_state']}")
                if r['round'] != 1:
                    return (False,
                            f"Cycle {r['idx']}: After auto-start, round should be 1 "
                            f"but got {r['round']}")

    return (True, "encrypt_auto_start: FSM correctly transitions to ENCRYPT after 144th bit")


def assert_encrypt_round_sequence(args):
    """
    Each encryption round applies addRoundKey, sBoxLayer, pLayer, and key schedule update
    in one clock edge. Verifies the operations: XOR state with key_reg[79:16], apply S-box
    to each nibble, apply pLayer permutation, update key_reg by rotating left 61 bits,
    applying S-box to top nibble, and XORing round counter into bits [19:15].
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_ENCRYPT = 1

    encrypt_edges = [r for r in records
                     if r['pre']['fsm_state'] == FSM_ENCRYPT and r['rst_n'] == 1]

    if not encrypt_edges:
        return (True, "No ENCRYPT-phase edges found; invariant vacuously satisfied")

    for r in encrypt_edges:
        pre = r['pre']
        pre_state = pre['state']
        pre_key = pre['key_reg']
        rnd = pre['round']

        if rnd < 1 or rnd > 31:
            continue  # skip sentinel rounds

        # Expected operations
        exp_state = pre_state ^ ((pre_key >> 16) & 0xFFFFFFFFFFFFFFFF)
        exp_state = _sbox_layer(exp_state)
        exp_state = _player(exp_state)
        exp_key = _key_schedule(pre_key, rnd)

        if r['state'] != exp_state:
            return (False,
                    f"Cycle {r['idx']} round {rnd}: state after round ops = "
                    f"0x{r['state']:016x}, expected 0x{exp_state:016x}")
        if r['key_reg'] != exp_key:
            return (False,
                    f"Cycle {r['idx']} round {rnd}: key_reg after schedule = "
                    f"0x{r['key_reg']:020x}, expected 0x{exp_key:020x}")

    return (True, f"encrypt_round_sequence verified across {len(encrypt_edges)} encrypt edges")


def assert_final_addroundkey(args):
    """
    After round 31 key schedule update, one additional edge applies the final addRoundKey
    and asserts done. State is XORed with key_reg[79:16] (using key_reg after round-31
    key schedule update), done is set to 1, and FSM transitions to DONE state.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_FINAL = 2
    FSM_DONE = 3

    final_edges = [r for r in records
                   if r['pre']['fsm_state'] == FSM_FINAL and r['rst_n'] == 1]

    if not final_edges:
        return (True, "No FINAL addRoundKey edges found; invariant vacuously satisfied")

    for r in final_edges:
        pre = r['pre']
        exp_state = pre['state'] ^ ((pre['key_reg'] >> 16) & 0xFFFFFFFFFFFFFFFF)

        if r['state'] != exp_state:
            return (False,
                    f"Cycle {r['idx']}: final addRoundKey state = "
                    f"0x{r['state']:016x}, expected 0x{exp_state:016x}")
        if r['done'] != 1:
            return (False,
                    f"Cycle {r['idx']}: done should be 1 after final addRoundKey, got {r['done']}")
        if r['fsm_state'] != FSM_DONE:
            return (False,
                    f"Cycle {r['idx']}: FSM should be DONE after final addRoundKey, "
                    f"got {r['fsm_state']}")

    return (True, f"final_addroundkey verified across {len(final_edges)} final-addRoundKey edges")


def assert_done_held(args):
    """
    Once done is asserted, it remains high on every subsequent rising edge unless
    rst_n is deasserted (asynchronous clear) or load_en goes high (synchronous clear
    on the rising edge where load_en is first seen high in DONE state).
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    edges = _rising_edges(stim)
    if len(edges) < 2:
        return (True, "Insufficient edges to check done_held")

    # Check observed done signal: once done=1, it should stay 1 unless
    # rst_n=0 or load_en=1
    prev_done = 0
    for i, idx in enumerate(edges):
        s = stim[idx]
        o = observed[idx]
        rst_n = _get(s, 'rst_n', 1)
        load_en = _get(s, 'load_en', 0)
        done = _get(o, 'done', 0)

        if prev_done == 1:
            if rst_n == 0:
                # Async reset: done may be cleared
                pass
            elif load_en == 1:
                # Synchronous clear allowed
                pass
            else:
                if done != 1:
                    return (False,
                            f"Cycle {idx}: done_held violated. done was 1 previously, "
                            f"but now done={done} without rst_n=0 or load_en=1")

        prev_done = done

    return (True, "done_held: done remains asserted correctly")


def assert_dout_during_unload(args):
    """
    dout reflects state[63] only when shift_out_en is high and done is asserted.
    In DONE state, dout equals state[63] when shift_out_en is high; on each rising
    edge where shift_out_en is high and done is asserted, state shifts left by one bit.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_DONE = 3

    unload_edges = [r for r in records
                    if r['pre']['fsm_state'] == FSM_DONE
                    and r['pre']['done'] == 1
                    and r['shift_out_en'] == 1
                    and r['rst_n'] == 1]

    if not unload_edges:
        return (True, "No unload edges found; invariant vacuously satisfied")

    for r in unload_edges:
        idx = r['idx']
        o = observed[idx]
        dout = _get(o, 'dout', 0)
        # dout should equal state[63] BEFORE the shift (pre-state)
        expected_dout = (r['pre']['state'] >> 63) & 1

        if dout != expected_dout:
            return (False,
                    f"Cycle {idx}: dout_during_unload: dout={dout}, "
                    f"expected state[63]={expected_dout}")

        # Verify state shifted left by 1 (state[0] = 0)
        expected_state = (r['pre']['state'] << 1) & 0xFFFFFFFFFFFFFFFF
        if r['state'] != expected_state:
            return (False,
                    f"Cycle {idx}: dout_during_unload: state after shift = "
                    f"0x{r['state']:016x}, expected 0x{expected_state:016x}")

    return (True, f"dout_during_unload verified across {len(unload_edges)} unload edges")


def assert_dout_zero_outside_unload(args):
    """
    dout is driven to 0 in all phases except active unload. Whenever the FSM is not
    in DONE state, or when in DONE state but shift_out_en is low, dout must be 0.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_DONE = 3

    violations = []
    for r in records:
        idx = r['idx']
        o = observed[idx]
        dout = _get(o, 'dout', 0)
        in_done = (r['pre']['fsm_state'] == FSM_DONE)
        shift_out_en = r['shift_out_en']
        done_flag = r['pre']['done']

        should_be_zero = not (in_done and shift_out_en == 1 and done_flag == 1)

        if should_be_zero and dout != 0:
            violations.append(
                f"Cycle {idx}: dout={dout} but should be 0 "
                f"(fsm_state={'DONE' if in_done else 'non-DONE'}, "
                f"shift_out_en={shift_out_en}, done={done_flag})"
            )

    if violations:
        return (False, "dout_zero_outside_unload violations:\n" + "\n".join(violations[:5]))

    return (True, "dout_zero_outside_unload: dout is 0 in all non-unload cycles")


def assert_async_reset_effect(args):
    """
    Asynchronous active-low reset immediately clears done and returns FSM to LOAD/IDLE.
    Whenever rst_n transitions to 0, done is immediately cleared to 0, the FSM returns
    to LOAD/IDLE state, load_cnt is cleared to 0, and any in-progress encryption is abandoned.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    edges = _rising_edges(stim)

    # Check: on any rising edge where rst_n=0, done must be 0
    for idx in edges:
        s = stim[idx]
        o = observed[idx]
        rst_n = _get(s, 'rst_n', 1)
        done = _get(o, 'done', 0)

        if rst_n == 0:
            if done != 0:
                return (False,
                        f"Cycle {idx}: async_reset_effect violated: "
                        f"rst_n=0 but done={done} (should be 0)")

    # Also check: cycle after rst_n goes low, done should be 0
    for i in range(1, len(edges)):
        idx = edges[i]
        prev_idx = edges[i - 1]
        s_prev = stim[prev_idx]
        s_curr = stim[idx]
        o_curr = observed[idx]
        rst_n_prev = _get(s_prev, 'rst_n', 1)
        rst_n_curr = _get(s_curr, 'rst_n', 1)
        done = _get(o_curr, 'done', 0)

        # If rst_n was 0 in previous cycle and is now 1, done should still be 0
        # (reset was released, but no new encryption has completed)
        if rst_n_prev == 0 and rst_n_curr == 1:
            if done != 0:
                return (False,
                        f"Cycle {idx}: After reset release, done={done} should be 0")

    return (True, "async_reset_effect: done correctly cleared during/after reset")


def assert_load_cnt_tracking(args):
    """
    load_cnt starts at 0 after reset; it increments by 1 on each rising edge where
    load_en is high and the FSM is in LOAD state; when load_cnt reaches 144, the
    ENCRYPT phase begins and load_cnt is no longer incremented.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_LOAD = 0

    # Verify load_cnt increments correctly
    for i in range(1, len(records)):
        r_prev = records[i - 1]
        r_curr = records[i]

        # Skip if reset happened
        if r_curr['rst_n'] == 0:
            continue

        pre_cnt = r_curr['pre']['load_cnt']
        post_cnt = r_curr['load_cnt']
        in_load = (r_curr['pre']['fsm_state'] == FSM_LOAD)
        load_en = r_curr['load_en']

        if in_load and load_en == 1:
            expected_cnt = pre_cnt + 1
            if post_cnt != expected_cnt and post_cnt != 144:
                # Allow staying at 144 if that's the transition point
                if pre_cnt < 144:
                    return (False,
                            f"Cycle {r_curr['idx']}: load_cnt should increment from "
                            f"{pre_cnt} to {expected_cnt}, got {post_cnt}")
        elif in_load and load_en == 0:
            if post_cnt != pre_cnt:
                return (False,
                        f"Cycle {r_curr['idx']}: load_cnt should not change when "
                        f"load_en=0, was {pre_cnt}, now {post_cnt}")

    # Verify load_cnt doesn't exceed 144
    for r in records:
        if r['load_cnt'] > 144:
            return (False,
                    f"Cycle {r['idx']}: load_cnt={r['load_cnt']} exceeds 144")

    return (True, "load_cnt_tracking: load_cnt increments correctly during LOAD phase")


def assert_round_counter_range(args):
    """
    The round counter runs from 1 to 31 inclusive during ENCRYPT phase.
    At the start of ENCRYPT, round is set to 1; it increments by 1 on each rising
    edge in ENCRYPT state; after round 31 completes, the final addRoundKey edge
    executes and the FSM moves to DONE; round never exceeds 31 during normal operation.
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_ENCRYPT = 1

    encrypt_edges = [r for r in records
                     if r['pre']['fsm_state'] == FSM_ENCRYPT and r['rst_n'] == 1]

    if not encrypt_edges:
        return (True, "No ENCRYPT edges found; invariant vacuously satisfied")

    for r in encrypt_edges:
        rnd = r['pre']['round']
        if rnd < 1 or rnd > 31:
            return (False,
                    f"Cycle {r['idx']}: round={rnd} is outside [1,31] during ENCRYPT state")

    # Verify round increments by 1 each ENCRYPT edge (except round 31 -> FSM_FINAL)
    for i in range(1, len(encrypt_edges)):
        r_prev = encrypt_edges[i - 1]
        r_curr = encrypt_edges[i]
        # Only check consecutive encrypt edges (no reset between them)
        if r_curr['pre']['round'] != r_prev['pre']['round'] + 1:
            # Could be a new encryption sequence starting at 1
            if r_curr['pre']['round'] != 1:
                return (False,
                        f"Cycle {r_curr['idx']}: round jumped from "
                        f"{r_prev['pre']['round']} to {r_curr['pre']['round']}, "
                        f"expected {r_prev['pre']['round'] + 1} or 1 (new sequence)")

    return (True, f"round_counter_range verified across {len(encrypt_edges)} encrypt edges")


def assert_key_schedule_rotate_left_61(args):
    """
    Key schedule rotation is a left rotation by 61 bits (equivalently right rotation
    by 19 bits). key_reg[(79-61):0] becomes the new key_reg[79:19] and
    key_reg[79:(80-61)] becomes the new key_reg[18:0].
    """
    stim, observed = args
    if not stim:
        return (True, "No cycles to check")

    records = _simulate_fsm_v2(stim)
    FSM_ENCRYPT = 1

    encrypt_edges = [r for r in records
                     if r['pre']['fsm_state'] == FSM_ENCRYPT and r['rst_n'] == 1]

    if not encrypt_edges:
        return (True, "No ENCRYPT edges found; invariant vacuously satisfied")

    for r in encrypt_edges:
        pre_key = r['pre']['key_reg']
        rnd = r['pre']['round']
        if rnd < 1 or rnd > 31:
            continue

        # Verify rotation: rotate left 61 = rotate right 19
        rotated = ((pre_key << 61) | (pre_key >> 19)) & ((1 << 80) - 1)

        # Verify bits [18:0] of rotated = bits [79:61] of pre_key
        expected_low19 = (pre_key >> 61) & ((1 << 19) - 1)
        actual_low19 = rotated & ((1 << 19) - 1)
        if actual_low19 != expected_low19:
            return (False,
                    f"Cycle {r['idx']} round {rnd}: rotation low 19 bits wrong: "
                    f"got 0x{actual_low19:05x}, expected 0x{expected_low19:05x}")

        # Verify bits [79:19] of rotated = bits [60:0] of pre_key
        expected_high61 = pre_key & ((1 << 61) - 1)
        actual_high61 = (rotated >> 19) & ((1 << 61) - 1)
        if actual_high61 != expected_high61:
            return (False,
                    f"Cycle {r['idx']} round {rnd}: rotation high 61 bits wrong: "
                    f"got 0x{actual_high61:016x}, expected 0x{expected_high61:016x}")

        # Verify the full key schedule (rotation + sbox + round xor) matches post key_reg
        exp_key = _key_schedule(pre_key, rnd)
        if r['key_reg'] != exp_key:
            return (False,
                    f"Cycle {r['idx']} round {rnd}: key_reg after schedule = "
                    f"0x{r['key_reg']:020x}, expected 0x{exp_key:020x}")

    return (True, f"key_schedule_rotate_left_61 verified across {len(encrypt_edges)} encrypt edges")
