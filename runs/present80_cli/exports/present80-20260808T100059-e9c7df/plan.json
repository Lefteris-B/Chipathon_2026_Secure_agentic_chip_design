  "top_module_id": "mod_present80",
  "modules": [
    {
      "module_id": "mod_present80",
      "name": "present80",
      "description": "Single-module PRESENT-80 lightweight block cipher with serial load/unload, iterative one-round-per-clock encryption, inline S-box, pLayer, key schedule, FSM, and counters.",
      "ports": [
        {
          "name": "clk",
          "direction": "in",
          "width": 1,
          "description": "Primary clock, 100 MHz"
        },
        {
          "name": "rst_n",
          "direction": "in",
          "width": 1,
          "description": "Asynchronous active-low reset"
        },
        {
          "name": "load_en",
          "direction": "in",
          "width": 1,
          "description": "Serial load enable; shifts din in while high"
        },
        {
          "name": "din",
          "direction": "in",
          "width": 1,
          "description": "Serial data input, key MSB-first then plaintext MSB-first"
        },
        {
          "name": "shift_out_en",
          "direction": "in",
          "width": 1,
          "description": "Serial unload enable; shifts ciphertext out while high and done is asserted"
        },
        {
          "name": "dout",
          "direction": "out",
          "width": 1,
          "description": "Serial data output, ciphertext MSB-first"
        },
        {
          "name": "done",
          "direction": "out",
          "width": 1,
          "description": "Asserted when ciphertext is fully computed; held until reset or new load"
        }
      ],
      "params": {
        "BLOCK_BITS": 64,
        "CLK_PERIOD_NS": 10,
        "ENCRYPT_CYCLES": 32,
        "KEY_BITS": 80,
        "LOAD_CYCLES": 144,
        "ROUNDS": 31,
        "UNLOAD_CYCLES": 64
      },
      "depends_on": []
    }
  ],
  "rationale": "The spec explicitly mandates a single flat Verilog module with all logic inlined (S-box LUT, pLayer permutation, key schedule rotation/substitution/counter-XOR, 3-state FSM: LOAD/ENCRYPT/UNLOAD, bit counters, and round counter). No sub-modules are permitted, so the hierarchy contains exactly one entry with depends_on=[]."
}