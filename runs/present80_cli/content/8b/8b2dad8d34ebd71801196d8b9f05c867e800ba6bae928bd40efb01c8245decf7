def assert_done_held_until_cleared(args):
    """
    Checks that once done is asserted, it remains high until rst_n goes low or load_en goes high.
    Verifies done is not spuriously deasserted between encryption completion and reset/reload.
    """
    stim, observed = args
    n = len(stim)
    for cycle in range(n - 1):
        s_cur = stim[cycle]
        s_next = stim[cycle + 1]
        o_cur = observed[cycle]
        o_next = observed[cycle + 1]

        if o_cur.get('done', 0) == 1:
            # done is currently high; check next cycle
            rst_next = s_next.get('rst_n', 1)
            load_next = s_next.get('load_en', 0)
            done_next = o_next.get('done', 0)

            # done should remain 1 unless rst_n goes low or load_en goes high
            if rst_next == 1 and load_next == 0 and done_next != 1:
                return (False,
                        f"Cycle {cycle}: done=1 but at cycle {cycle+1} done={done_next} "
                        f"without rst_n=0 or load_en=1 (rst_n={rst_next}, load_en={load_next}). "
                        f"done should be held high.")
    return (True, "done_held_until_cleared: done correctly held high until rst_n or load_en clears it")


def assert_dout_idle_value(args):
    """
    Checks that dout is 0 whenever shift_out_en is low or done is low.
    dout should only be non-zero during the unload phase (done=1 and shift_out_en=1).
    """
    stim, observed = args
    for cycle, (s, o) in enumerate(zip(stim, observed)):
        shift_out_en = s.get('shift_out_en', 0)
        done = o.get('done', 0)
        dout = o.get('dout', 0)

        if shift_out_en == 0 or done == 0:
            if dout != 0:
                return (False,
                        f"Cycle {cycle}: dout={dout} but shift_out_en={shift_out_en} and done={done}. "
                        f"dout must be 0 when not in unload phase.")
    return (True, "dout_idle_value: dout is 0 whenever shift_out_en=0 or done=0")


def assert_no_partial_encrypt_output(args):
    """
    Checks that done is never asserted before all 32 encryption cycles have completed.
    done must remain 0 throughout the 144 load cycles and all 32 encrypt cycles.
    """
    stim, observed = args
    n = len(stim)

    # Track load phase and encryption phase
    load_count = 0
    in_load = False
    encrypt_count = 0
    in_encrypt = False

    for cycle in range(n):
        s = stim[cycle]
        o = observed[cycle]
        rst_n = s.get('rst_n', 1)
        load_en = s.get('load_en', 0)
        done = o.get('done', 0)

        if rst_n == 0:
            load_count = 0
            in_load = False
            encrypt_count = 0
            in_encrypt = False
            continue

        if load_en == 1:
            if not in_load:
                in_load = True
                load_count = 0
                in_encrypt = False
                encrypt_count = 0
            load_count += 1
            # During load phase, done must be 0
            if done != 0:
                return (False,
                        f"Cycle {cycle}: done={done} during load phase (load bit {load_count}). "
                        f"done must be 0 throughout load phase.")
            if load_count == 144:
                in_load = False
                in_encrypt = True
                encrypt_count = 0
        elif in_encrypt:
            encrypt_count += 1
            if encrypt_count < 32:
                # During encryption (before 32nd cycle completes), done must be 0
                if done != 0:
                    return (False,
                            f"Cycle {cycle}: done={done} during encrypt cycle {encrypt_count} "
                            f"(before 32nd cycle). done must be 0 until all 32 cycles complete.")
            elif encrypt_count == 32:
                in_encrypt = False
                # After 32nd cycle, done should be asserted (but we don't enforce it here,
                # that's a liveness property; we only check no early assertion)
        elif in_load:
            # load_en went low before 144 bits - partial load, reset state
            in_load = False
            load_count = 0

    return (True, "no_partial_encrypt_output: done never asserted before all 32 encrypt cycles complete")


def assert_load_en_aborts_encryption(args):
    """
    Checks that asserting load_en during encryption or after done is asserted clears done
    and starts a new load sequence. Verifies done goes to 0 when load_en goes high
    after the load phase has ended.
    """
    stim, observed = args
    n = len(stim)

    load_count = 0
    in_load = False
    post_load = False  # True after 144 bits loaded (during encrypt or unload)

    for cycle in range(n):
        s = stim[cycle]
        o = observed[cycle]
        rst_n = s.get('rst_n', 1)
        load_en = s.get('load_en', 0)
        done = o.get('done', 0)

        if rst_n == 0:
            load_count = 0
            in_load = False
            post_load = False
            continue

        if load_en == 1:
            if post_load:
                # load_en asserted after load phase ended - done should be cleared
                if done != 0:
                    return (False,
                            f"Cycle {cycle}: load_en=1 after load phase ended but done={done}. "
                            f"done should be cleared when load_en goes high after load phase.")
                # Reset tracking for new load
                post_load = False
                in_load = True
                load_count = 1
            elif in_load:
                load_count += 1
                if load_count == 144:
                    in_load = False
                    post_load = True
            else:
                in_load = True
                load_count = 1
        else:
            if in_load and load_count < 144:
                # load_en dropped before 144 bits - incomplete load
                in_load = False
                load_count = 0
                post_load = False

    return (True, "load_en_aborts_encryption: load_en correctly clears done and aborts encryption/unload")


def assert_unload_serial_output(args):
    """
    Checks that ciphertext is shifted out MSB-first on dout while done=1 and shift_out_en=1.
    Verifies that the 64 bits output during unload match the expected PRESENT-80 ciphertext
    computed from the loaded key and plaintext.
    """
    stim, observed = args
    episodes = _parse_stimulus(stim, observed)
    if not episodes:
        return (True, "unload_serial_output: no complete episodes found to verify")

    for ep in episodes:
        unload_cycs = ep['unload_cycles']
        if len(unload_cycs) == 0:
            continue
        if len(unload_cycs) < 64:
            # Partial unload - check what was output
            observed_bits = 0
            for cyc in unload_cycs:
                observed_bits = (observed_bits << 1) | observed[cyc].get('dout', 0)
            expected = ep['ciphertext']
            # Check the MSBs match
            shift = 64 - len(unload_cycs)
            expected_partial = (expected >> shift) & ((1 << len(unload_cycs)) - 1)
            if observed_bits != expected_partial:
                return (False,
                        f"unload_serial_output: partial unload mismatch after {len(unload_cycs)} bits. "
                        f"Expected MSBs 0x{expected_partial:X}, got 0x{observed_bits:X}.")
        else:
            observed_bits = 0
            for cyc in unload_cycs[:64]:
                observed_bits = (observed_bits << 1) | observed[cyc].get('dout', 0)
            expected = ep['ciphertext']
            if observed_bits != expected:
                return (False,
                        f"unload_serial_output: ciphertext mismatch. "
                        f"Expected 0x{expected:016X}, got 0x{observed_bits:016X}. "
                        f"Serial output does not match expected PRESENT-80 ciphertext.")
    return (True, "unload_serial_output: serial ciphertext output matches expected PRESENT-80 encryption")
