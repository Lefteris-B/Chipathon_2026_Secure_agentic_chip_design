# rationale: We only have access to the serial interface (stim/observed), so we must reconstruct
# internal state by simulating the PRESENT-80 cipher from the stimulus bits.
# For invariants that require internal state knowledge (addroundkey, sbox, player, key_schedule_*),
# we simulate the cipher and compare against expected behavior derived from the stimulus.
# For interface-level invariants (reset_clears_done, done_held_until_cleared, dout_idle_value,
# no_partial_encrypt_output, load_en_aborts_encryption, unload_serial_output), we check
# the observed outputs against the stimulus signals directly.
# The test_vector_correctness invariant is NOT in referenced_invariants, so we skip it.

SBOX = [0xC, 0x5, 0x6, 0xB, 0x9, 0x0, 0xA, 0xD, 0x3, 0xE, 0xF, 0x8, 0x4, 0x7, 0x1, 0x2]

def _apply_sbox_to_state(state):
    """Apply PRESENT S-box to all 16 nibbles of 64-bit state."""
    result = 0
    for i in range(16):
        nibble = (state >> (4 * i)) & 0xF
        result |= SBOX[nibble] << (4 * i)
    return result

def _apply_player(state):
    """Apply PRESENT pLayer permutation to 64-bit state."""
    result = 0
    for i in range(63):
        bit = (state >> i) & 1
        p = (i * 16) % 63
        result |= bit << p
    # P(63) = 63
    bit63 = (state >> 63) & 1
    result |= bit63 << 63
    return result

def _apply_key_schedule(key_reg, round_idx):
    """Apply PRESENT-80 key schedule: rotate left 61, S-box top nibble, XOR round counter."""
    # Rotate left by 61 bits (80-bit key)
    key_reg = key_reg & ((1 << 80) - 1)
    rotated = ((key_reg << 61) | (key_reg >> 19)) & ((1 << 80) - 1)
    # Apply S-box to top nibble (bits 79:76)
    top_nibble = (rotated >> 76) & 0xF
    new_top = SBOX[top_nibble]
    rotated = (rotated & ~(0xF << 76)) | (new_top << 76)
    # XOR round counter into bits 19:15
    rotated ^= (round_idx & 0x1F) << 15
    return rotated

def _simulate_present80(key_reg, state):
    """Simulate full PRESENT-80 encryption: 31 rounds + final addRoundKey."""
    for rnd in range(1, 32):
        # addRoundKey: XOR upper 64 bits of key_reg (bits 79:16) into state
        round_key = (key_reg >> 16) & ((1 << 64) - 1)
        state ^= round_key
        # sBoxLayer
        state = _apply_sbox_to_state(state)
        # pLayer
        state = _apply_player(state)
        # key schedule
        key_reg = _apply_key_schedule(key_reg, rnd)
    # Final addRoundKey (32nd cycle)
    round_key = (key_reg >> 16) & ((1 << 64) - 1)
    state ^= round_key
    return state, key_reg

def _parse_stimulus(stim, observed):
    """
    Parse the stimulus to find load phases, encryption phases, and unload phases.
    Returns a list of 'episodes', each a dict with:
      - 'load_start': cycle index where load began
      - 'load_bits': list of din bits (144 bits)
      - 'key_reg': reconstructed 80-bit key
      - 'plaintext': reconstructed 64-bit plaintext
      - 'encrypt_start': cycle index where encryption started
      - 'encrypt_end': cycle index where encryption ended (done asserted)
      - 'ciphertext': expected ciphertext
      - 'unload_cycles': list of cycle indices where shift_out_en and done are both high
    """
    episodes = []
    n = len(stim)
    i = 0
    while i < n:
        # Find a load phase: look for load_en=1
        # Check if rst_n is low - skip reset cycles
        if stim[i].get('rst_n', 1) == 0:
            i += 1
            continue
        if stim[i].get('load_en', 0) == 1:
            # Start of a load phase
            load_start = i
            load_bits = []
            while i < n and stim[i].get('load_en', 0) == 1 and stim[i].get('rst_n', 1) == 1:
                load_bits.append(stim[i].get('din', 0))
                i += 1
                if len(load_bits) == 144:
                    break
            if len(load_bits) < 144:
                # Incomplete load - skip
                continue
            # Reconstruct key and plaintext
            key_reg = 0
            for b in range(80):
                key_reg = (key_reg << 1) | load_bits[b]
            plaintext = 0
            for b in range(64):
                plaintext = (plaintext << 1) | load_bits[80 + b]
            # Find encrypt phase: next 32 cycles (no load_en, no rst_n)
            encrypt_start = i
            encrypt_end = None
            # Look for done assertion
            enc_cycles = 0
            j = i
            while j < n and enc_cycles < 32:
                if stim[j].get('rst_n', 1) == 0:
                    break
                if stim[j].get('load_en', 0) == 1:
                    break
                enc_cycles += 1
                j += 1
            if enc_cycles == 32:
                encrypt_end = j - 1
                ciphertext, _ = _simulate_present80(key_reg, plaintext)
                # Find unload cycles
                unload_cycs = []
                k = j
                while k < n:
                    if stim[k].get('rst_n', 1) == 0:
                        break
                    if stim[k].get('load_en', 0) == 1:
                        break
                    if observed[k].get('done', 0) == 1 and stim[k].get('shift_out_en', 0) == 1:
                        unload_cycs.append(k)
                    k += 1
                episodes.append({
                    'load_start': load_start,
                    'load_bits': load_bits,
                    'key_reg': key_reg,
                    'plaintext': plaintext,
                    'encrypt_start': encrypt_start,
                    'encrypt_end': encrypt_end,
                    'ciphertext': ciphertext,
                    'unload_cycles': unload_cycs,
                    'post_encrypt_start': j,
                })
        else:
            i += 1
    return episodes


def assert_reset_clears_done(args):
    """
    Checks that whenever rst_n is low, done is 0 on that same cycle.
    This verifies the asynchronous active-low reset immediately clears done.
    """
    stim, observed = args
    for cycle, (s, o) in enumerate(zip(stim, observed)):
        if s.get('rst_n', 1) == 0:
            if o.get('done', 0) != 0:
                return (False, f"Cycle {cycle}: rst_n=0 but done={o.get('done',0)}, expected done=0")
    return (True, "reset_clears_done: done is 0 whenever rst_n is low across all cycles")


def assert_addroundkey_operation(args):
    """
    Checks that addRoundKey correctly XORs the upper 64 bits of key_reg (bits 79:16) into state
    at the start of each round. Verified by simulating the cipher and checking the final ciphertext
    matches what the serial output produces.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "addroundkey_operation: no cycles to check")

    # We verify this indirectly: simulate the cipher with the correct addRoundKey operation
    # and check that the unloaded ciphertext matches our simulation.
    episodes = _parse_stimulus(stim, observed)
    if not episodes:
        return (True, "addroundkey_operation: no complete encrypt episodes found to verify")

    for ep in episodes:
        # Collect unloaded bits
        unload_cycs = ep['unload_cycles']
        if len(unload_cycs) < 64:
            continue
        observed_bits = 0
        for cyc in unload_cycs[:64]:
            observed_bits = (observed_bits << 1) | observed[cyc].get('dout', 0)
        expected = ep['ciphertext']
        if observed_bits != expected:
            return (False,
                    f"addroundkey_operation: ciphertext mismatch. "
                    f"Expected 0x{expected:016X}, got 0x{observed_bits:016X}. "
                    f"addRoundKey may be incorrect (wrong bits of key_reg XORed).")
    return (True, "addroundkey_operation: addRoundKey XOR verified correct via ciphertext match")


