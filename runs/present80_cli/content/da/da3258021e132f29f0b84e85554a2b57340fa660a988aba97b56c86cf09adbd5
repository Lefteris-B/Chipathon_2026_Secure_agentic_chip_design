# rationale: Implement PRESENT-80 block cipher reference model following the contract exactly.
# rationale: FSM states: IDLE=0, LOAD=1, ENCRYPT=2, DONE=3
# rationale: Reset is asynchronous active-low; clears all state immediately when rst_n==0.
# rationale: Load phase: 144 bits shifted MSB-first into {key_reg[79:0], state[63:0]}.
# rationale: Encrypt phase: 32 cycles; rounds 1-31 do addRoundKey+sBox+pLayer+keySchedule, round 32 does only addRoundKey.
# rationale: Key schedule: rotate left 61, sbox top nibble, XOR round index into bits 19:15.
# rationale: Unload: MSB-first, pauses when shift_out_en is low.
# rationale: load_en at any time outside LOAD resets to LOAD state and clears done.

SBOX = [0xC, 0x5, 0x6, 0xB, 0x9, 0x0, 0xA, 0xD, 0x3, 0xE, 0xF, 0x8, 0x4, 0x7, 0x1, 0x2]

def _sbox_layer(state):
    result = 0
    for nibble_idx in range(16):
        nibble = (state >> (nibble_idx * 4)) & 0xF
        result |= SBOX[nibble] << (nibble_idx * 4)
    return result

def _player(state):
    result = 0
    for i in range(63):
        bit = (state >> i) & 1
        p = (i * 16) % 63
        result |= bit << p
    # P(63) = 63
    bit63 = (state >> 63) & 1
    result |= bit63 << 63
    return result

def _key_schedule(key_reg, round_idx):
    # Rotate left by 61 bits (80-bit register)
    key_reg = ((key_reg << 61) | (key_reg >> 19)) & 0xFFFFFFFFFFFFFFFFFFFF
    # Apply S-box to top nibble (bits 79:76)
    top_nibble = (key_reg >> 76) & 0xF
    key_reg = (key_reg & 0x0FFFFFFFFFFFFFFFFFFFFFFF) | (SBOX[top_nibble] << 76)
    # Mask to 80 bits
    key_reg &= 0xFFFFFFFFFFFFFFFFFFFF
    # XOR round index into bits 19:15
    key_reg ^= (round_idx & 0x1F) << 15
    return key_reg

def reference(stim: list[dict]) -> list[dict]:
    # FSM states
    IDLE = 0
    LOAD = 1
    ENCRYPT = 2
    DONE = 3

    fsm = IDLE
    key_reg = 0       # 80-bit
    state = 0         # 64-bit
    load_counter = 0  # counts bits loaded (0..144)
    round_counter = 0 # current encrypt round (1..32)
    done = 0
    unload_counter = 0  # bits shifted out (0..64)

    out = []

    for cyc in stim:
        rst_n = cyc.get("rst_n", 1)
        load_en = cyc.get("load_en", 0)
        din = cyc.get("din", 0)
        shift_out_en = cyc.get("shift_out_en", 0)

        if rst_n == 0:
            # Asynchronous reset: clear everything
            fsm = IDLE
            key_reg = 0
            state = 0
            load_counter = 0
            round_counter = 0
            done = 0
            unload_counter = 0
            out.append({"dout": 0, "done": 0})
            continue

        # Normal operation
        dout = 0

        # Check if load_en is asserted outside of LOAD state -> abort and restart load
        if load_en == 1 and fsm != LOAD:
            fsm = LOAD
            done = 0
            load_counter = 0
            key_reg = 0
            state = 0
            unload_counter = 0

        if fsm == IDLE:
            # Stay idle until load_en
            if load_en == 1:
                fsm = LOAD
                load_counter = 0
                key_reg = 0
                state = 0

        if fsm == LOAD:
            if load_en == 1:
                # Shift din MSB-first into {key_reg[79:0], state[63:0]}
                # The 144-bit shift register: key_reg is upper 80 bits, state is lower 64 bits
                # MSB-first: first bit received goes to key_reg[79], last to state[0]
                # Shift left and insert din at LSB of the combined register
                combined = (key_reg << 64) | state  # 144-bit combined
                combined = ((combined << 1) | din) & ((1 << 144) - 1)
                key_reg = (combined >> 64) & 0xFFFFFFFFFFFFFFFFFFFF
                state = combined & 0xFFFFFFFFFFFFFFFF
                load_counter += 1

                if load_counter == 144:
                    # Transition to ENCRYPT, first round begins immediately
                    fsm = ENCRYPT
                    round_counter = 1
                    load_counter = 0

        elif fsm == ENCRYPT:
            # Apply addRoundKey: state XOR key_reg[79:16]
            round_key = (key_reg >> 16) & 0xFFFFFFFFFFFFFFFF
            state = state ^ round_key

            if round_counter <= 31:
                # Apply sBoxLayer
                state = _sbox_layer(state)
                # Apply pLayer
                state = _player(state)
                # Key schedule update for this round
                key_reg = _key_schedule(key_reg, round_counter)
                round_counter += 1
            else:
                # round_counter == 32: final addRoundKey only, done
                done = 1
                fsm = DONE
                unload_counter = 0

        elif fsm == DONE:
            if shift_out_en == 1:
                # Output MSB-first: state[63] first
                bit_idx = 63 - unload_counter
                dout = (state >> bit_idx) & 1
                unload_counter += 1
                if unload_counter >= 64:
                    unload_counter = 64  # saturate, stay in DONE

        out.append({"dout": dout, "done": done})

    return out
