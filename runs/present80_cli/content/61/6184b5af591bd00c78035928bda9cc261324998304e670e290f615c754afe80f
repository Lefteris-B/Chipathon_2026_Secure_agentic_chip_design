module present80 #(
    parameter BLOCK_BITS   = 64,
    parameter CLK_PERIOD_NS = 10,
    parameter ENCRYPT_CYCLES = 32,
    parameter KEY_BITS     = 80,
    parameter LOAD_CYCLES  = 144,
    parameter ROUNDS       = 31,
    parameter UNLOAD_CYCLES = 64
)(
    input  wire clk,
    input  wire rst_n,
    input  wire load_en,
    input  wire din,
    input  wire shift_out_en,
    output wire dout,
    output reg  done
);

// ============================================================
// State machine
// ============================================================
localparam ST_IDLE    = 3'd0;
localparam ST_LOAD    = 3'd1;
localparam ST_ENCRYPT = 3'd2;
localparam ST_DONE    = 3'd3;
localparam ST_UNLOAD  = 3'd4;

reg [2:0] state, next_state;

// ============================================================
// Registers
// ============================================================
reg [KEY_BITS-1:0]   key_reg;
reg [BLOCK_BITS-1:0] block_reg;
reg [7:0]            load_cnt;   // counts bits loaded (0..143)
reg [4:0]            round_cnt;  // counts rounds done (0..30)
reg [6:0]            unload_cnt; // counts bits unloaded (0..63)

// ============================================================
// S-box (4-bit, PRESENT specification)
// ============================================================
function [3:0] sbox;
    input [3:0] x;
    case (x)
        4'h0: sbox = 4'hC;
        4'h1: sbox = 4'h5;
        4'h2: sbox = 4'h6;
        4'h3: sbox = 4'hB;
        4'h4: sbox = 4'h9;
        4'h5: sbox = 4'h0;
        4'h6: sbox = 4'hA;
        4'h7: sbox = 4'hD;
        4'h8: sbox = 4'h3;
        4'h9: sbox = 4'hE;
        4'hA: sbox = 4'hF;
        4'hB: sbox = 4'h8;
        4'hC: sbox = 4'h4;
        4'hD: sbox = 4'h7;
        4'hE: sbox = 4'h1;
        4'hF: sbox = 4'h2;
        default: sbox = 4'h0;
    endcase
endfunction

// ============================================================
// S-layer: apply sbox to all 16 nibbles
// ============================================================
function [63:0] s_layer;
    input [63:0] x;
    integer i;
    begin
        for (i = 0; i < 16; i = i + 1)
            s_layer[i*4 +: 4] = sbox(x[i*4 +: 4]);
    end
endfunction

// ============================================================
// pLayer: bit permutation P(i) = (i/4) + 16*(i mod 4)
// ============================================================
function [63:0] p_layer;
    input [63:0] x;
    integer i;
    reg [5:0] dest;
    begin
        p_layer = 64'd0;
        for (i = 0; i < 64; i = i + 1) begin
            dest = (i / 4) + 16 * (i % 4);
            p_layer[dest] = x[i];
        end
    end
endfunction

// ============================================================
// Key schedule: update key register for next round
// round_num is the current round number (1-based, 1..31)
// ============================================================
function [79:0] key_schedule;
    input [79:0] k;
    input [4:0]  round_num; // round counter value (1..31)
    reg [79:0] k1;
    reg [4:0]  rc;
    begin
        // 1. Rotate left by 61 (equivalent to rotate right by 19)
        k1 = {k[18:0], k[79:19]};
        // 2. S-box on top 4 bits
        k1[79:76] = sbox(k1[79:76]);
        // 3. XOR round counter into bits [19:15]
        rc = round_num;
        k1[19:15] = k1[19:15] ^ rc;
        key_schedule = k1;
    end
endfunction

// ============================================================
// One round of PRESENT encryption
// ============================================================
function [63:0] present_round;
    input [63:0] blk;
    input [63:0] rkey;
    reg [63:0] t;
    begin
        t = blk ^ rkey;
        t = s_layer(t);
        t = p_layer(t);
        present_round = t;
    end
endfunction

// ============================================================
// FSM: state register
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if (!rst_n)
        state <= ST_IDLE;
    else
        state <= next_state;
end

// ============================================================
// FSM: next state logic
// ============================================================
always @(*) begin
    next_state = state;
    case (state)
        ST_IDLE: begin
            if (load_en)
                next_state = ST_LOAD;
        end
        ST_LOAD: begin
            // After loading 144 bits (load_cnt reaches 143 on last bit)
            if (!load_en)
                next_state = ST_IDLE;
            else if (load_cnt == (LOAD_CYCLES - 1))
                next_state = ST_ENCRYPT;
        end
        ST_ENCRYPT: begin
            if (round_cnt == (ROUNDS - 1))
                next_state = ST_DONE;
        end
        ST_DONE: begin
            if (shift_out_en)
                next_state = ST_UNLOAD;
        end
        ST_UNLOAD: begin
            if (unload_cnt == (UNLOAD_CYCLES - 1))
                next_state = ST_DONE;
            if (!shift_out_en)
                next_state = ST_DONE;
        end
        default: next_state = ST_IDLE;
    endcase
end

// ============================================================
// Load counter
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if (!rst_n)
        load_cnt <= 8'd0;
    else if (state == ST_LOAD)
        load_cnt <= load_cnt + 8'd1;
    else
        load_cnt <= 8'd0;
end

// ============================================================
// Serial load: key MSB-first (80 bits) then plaintext MSB-first (64 bits)
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        key_reg   <= {KEY_BITS{1'b0}};
        block_reg <= {BLOCK_BITS{1'b0}};
    end else if (state == ST_LOAD) begin
        if (load_cnt < KEY_BITS) begin
            // Shift key: MSB first
            key_reg <= {key_reg[KEY_BITS-2:0], din};
        end else begin
            // Shift block: MSB first
            block_reg <= {block_reg[BLOCK_BITS-2:0], din};
        end
    end else if (state == ST_ENCRYPT) begin
        // Perform one round per clock
        // The key to use for this round is the current key_reg (top 64 bits)
        block_reg <= present_round(block_reg, key_reg[79:16]);
        key_reg   <= key_schedule(key_reg, round_cnt + 5'd1);
    end else if (state == ST_UNLOAD && shift_out_en) begin
        // Shift out MSB first
        block_reg <= {block_reg[BLOCK_BITS-2:0], 1'b0};
    end
end

// ============================================================
// Round counter
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if (!rst_n)
        round_cnt <= 5'd0;
    else if (state == ST_ENCRYPT)
        round_cnt <= round_cnt + 5'd1;
    else
        round_cnt <= 5'd0;
end

// ============================================================
// Unload counter
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if (!rst_n)
        unload_cnt <= 7'd0;
    else if (state == ST_UNLOAD && shift_out_en)
        unload_cnt <= unload_cnt + 7'd1;
    else if (state != ST_UNLOAD)
        unload_cnt <= 7'd0;
end

// ============================================================
// Done flag
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if (!rst_n)
        done <= 1'b0;
    else if (next_state == ST_DONE)
        done <= 1'b1;
    else if (state == ST_LOAD || state == ST_ENCRYPT)
        done <= 1'b0;
    else if (state == ST_IDLE)
        done <= 1'b0;
end

// ============================================================
// Serial output: MSB of block_reg
// ============================================================
assign dout = block_reg[BLOCK_BITS-1];

endmodule
