def assert_done_asserted_after_encrypt(args):
    """
    Checks that done transitions to 1 after the 32nd encrypt cycle and remains high
    until reset or a new load begins.
    """
    stim, observed = args
    key, plaintext, load_start = _extract_load_data(stim)
    if key is None:
        return True, "done_asserted_after_encrypt: no complete load sequence found, skipping"

    # Find cycle where 144th bit was loaded
    count = 0
    load_end_cycle = None
    for i in range(len(stim)):
        if stim[i].get('load_en', 0):
            count += 1
            if count == 144:
                load_end_cycle = i
                break

    if load_end_cycle is None:
        return True, "done_asserted_after_encrypt: load incomplete, skipping"

    # done should assert within ~32 cycles after load_end_cycle
    done_cycle = None
    for i in range(load_end_cycle + 1, min(load_end_cycle + 40, len(observed))):
        if observed[i].get('done', 0) == 1:
            done_cycle = i
            break

    if done_cycle is None:
        return False, (f"done_asserted_after_encrypt: done never asserted within 40 cycles "
                       f"after load completion at cycle {load_end_cycle}")

    cycles_after_load = done_cycle - load_end_cycle
    if cycles_after_load < 30 or cycles_after_load > 34:
        return False, (f"done_asserted_after_encrypt: done asserted {cycles_after_load} cycles "
                       f"after load end (expected ~32)")

    # Check done remains high until reset or new load
    for i in range(done_cycle, len(observed)):
        rst = stim[i].get('rst_n', 1)
        le = stim[i].get('load_en', 0)
        d = observed[i].get('done', 0)

        if rst == 0:
            # Reset - done should be 0
            if d != 0:
                return False, (f"done_asserted_after_encrypt: done not cleared by reset "
                               f"at cycle {i}")
            break
        if le == 1 and d == 0:
            # New load started, done cleared - acceptable
            break
        if d == 0 and rst == 1 and le == 0:
            return False, (f"done_asserted_after_encrypt: done unexpectedly cleared at "
                           f"cycle {i} without reset or new load")

    return True, (f"done_asserted_after_encrypt: done asserted at cycle {done_cycle} "
                  f"({cycles_after_load} cycles after load end)")


def assert_unload_serial_msb_first(args):
    """
    Checks that while done=1 and shift_out_en=1, dout outputs ciphertext bits MSB-first.
    Collects 64 dout bits and verifies they match the simulated ciphertext MSB-first.
    """
    stim, observed = args
    key, plaintext, _ = _extract_load_data(stim)
    if key is None:
        return True, "unload_serial_msb_first: no complete load sequence found, skipping"

    expected_ct, _, _ = _simulate_present80(key, plaintext)

    # Collect dout bits when done=1 and shift_out_en=1
    dout_bits = []
    for i, (s, o) in enumerate(zip(stim, observed)):
        if o.get('done', 0) == 1 and s.get('shift_out_en', 0) == 1:
            dout_bits.append(o.get('dout', 0) & 1)
        if len(dout_bits) == 64:
            break

    if len(dout_bits) < 64:
        return True, (f"unload_serial_msb_first: only {len(dout_bits)} bits observed "
                      f"during unload, cannot fully verify")

    # Reconstruct observed ciphertext from MSB-first serial stream
    observed_ct = 0
    for b in dout_bits:
        observed_ct = (observed_ct << 1) | b

    # Verify bit-by-bit order: first bit should be state[63]
    errors = []
    for bit_idx in range(64):
        expected_bit = (expected_ct >> (63 - bit_idx)) & 1
        if dout_bits[bit_idx] != expected_bit:
            errors.append((bit_idx, expected_bit, dout_bits[bit_idx]))

    if errors:
        return False, (f"unload_serial_msb_first: {len(errors)} bit mismatches. "
                       f"First error at bit position {errors[0][0]}: "
                       f"expected {errors[0][1]}, got {errors[0][2]}. "
                       f"Expected CT=0x{expected_ct:016X}, got 0x{observed_ct:016X}")

    return True, (f"unload_serial_msb_first: all 64 ciphertext bits match MSB-first "
                  f"for CT=0x{expected_ct:016X}")


def assert_dout_stable_when_not_unloading(args):
    """
    Checks that dout is only required to be valid when done=1 and shift_out_en=1.
    This assertion verifies the contract is not violated by checking that we do NOT
    require dout to be any specific value when done=0 or shift_out_en=0.
    Since the contract says dout may be any value in those cases, we simply verify
    that the observed dout is always 0 or 1 (a valid binary signal).
    """
    stim, observed = args
    invalid = []
    for i, o in enumerate(observed):
        dout_val = o.get('dout', 0)
        if dout_val not in (0, 1):
            invalid.append((i, dout_val))

    if invalid:
        return False, (f"dout_stable_when_not_unloading: dout has non-binary values at "
                       f"cycles {invalid[:5]}")

    # Additionally verify: when done=0 or shift_out_en=0, we make no assertion on dout value
    # (the contract explicitly says it may be any value)
    # We just confirm the signal is always binary
    return True, ("dout_stable_when_not_unloading: dout is always a valid binary signal; "
                  "no validity requirement when done=0 or shift_out_en=0")


def assert_new_load_aborts_done(args):
    """
    Checks that asserting load_en while done=1 clears done and begins a new load phase.
    Scans for cycles where done=1 and load_en=1, then verifies done is cleared.
    """
    stim, observed = args
    n = min(len(stim), len(observed))

    violations = []
    for i in range(n - 1):
        done_now = observed[i].get('done', 0)
        le_now = stim[i].get('load_en', 0)

        if done_now == 1 and le_now == 1:
            # On the next cycle, done should be cleared (or reset occurred)
            rst_next = stim[i + 1].get('rst_n', 1) if i + 1 < n else 1
            done_next = observed[i + 1].get('done', 0) if i + 1 < n else 0

            if rst_next == 0:
                # Reset takes priority, skip
                continue

            # After load_en asserted while done=1, done should be 0 on next cycle
            # (or at least within a couple cycles as the FSM transitions)
            if done_next == 1:
                # Check if load_en is still high (could still be in transition)
                le_next = stim[i + 1].get('load_en', 0) if i + 1 < n else 0
                if le_next == 0:
                    # load_en went low but done is still 1 - this might be ok if
                    # the FSM needs one cycle to clear done
                    pass
                else:
                    # load_en still high and done still high - check one more cycle
                    if i + 2 < n:
                        done_2 = observed[i + 2].get('done', 0)
                        rst_2 = stim[i + 2].get('rst_n', 1)
                        if done_2 == 1 and rst_2 == 1:
                            violations.append(i)

    if violations:
        return False, (f"new_load_aborts_done: done not cleared after load_en asserted "
                       f"while done=1 at cycles: {violations[:10]}")

    # Check if we ever observed the scenario
    scenario_found = any(
        observed[i].get('done', 0) == 1 and stim[i].get('load_en', 0) == 1
        for i in range(n)
    )

    if not scenario_found:
        return True, "new_load_aborts_done: scenario (done=1 and load_en=1) not observed, skipping"

    return True, "new_load_aborts_done: done correctly cleared when load_en asserted during done=1"
