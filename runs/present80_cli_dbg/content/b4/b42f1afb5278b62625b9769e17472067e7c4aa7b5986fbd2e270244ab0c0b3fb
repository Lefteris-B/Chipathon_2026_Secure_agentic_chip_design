# rationale: Implement PRESENT-80 reference model following the contract exactly.
# rationale: FSM states: IDLE/LOAD=0, ENCRYPT=1, DONE=2
# rationale: Load phase shifts {key_reg, state} left, inserting din at LSB; counter goes 1..144
# rationale: Encrypt: 31 full rounds + 1 final addRoundKey = 32 cycles total
# rationale: Key schedule: rotate left 61, S-box top nibble, XOR round_counter into bits [19:15]
# rationale: pLayer: P(i) = (i*16) mod 63 for i in 0..62, P(63)=63
# rationale: dout=0 when not (done and shift_out_en)

def reference(stim: list[dict]) -> list[dict]:
    SBOX = [0xC, 0x5, 0x6, 0xB, 0x9, 0x0, 0xA, 0xD,
            0x3, 0xE, 0xF, 0x8, 0x4, 0x7, 0x1, 0x2]

    def sbox_layer(state64):
        result = 0
        for nibble_idx in range(16):
            shift = (15 - nibble_idx) * 4
            nibble = (state64 >> shift) & 0xF
            result |= SBOX[nibble] << shift
        return result

    def player(state64):
        result = 0
        for i in range(63):
            bit = (state64 >> (63 - i)) & 1
            p = (i * 16) % 63
            result |= bit << (63 - p)
        # bit 63 stays at 63
        bit63 = (state64 >> 0) & 1  # bit position 0 in LSB-first = bit 63 in MSB-first
        # Wait - need to clarify bit ordering.
        # state64 is a 64-bit integer. Bit i means bit index i from LSB=0.
        # P(i) = (i*16) mod 63 for i in 0..62, P(63)=63
        # Bit i of pre-permutation goes to position P(i) of post-permutation
        result = 0
        for i in range(63):
            bit = (state64 >> i) & 1
            p = (i * 16) % 63
            result |= bit << p
        bit63 = (state64 >> 63) & 1
        result |= bit63 << 63
        return result

    def key_schedule(key_reg, round_counter):
        # Step 1: rotate left by 61 bits (80-bit register)
        key_reg = ((key_reg << 61) | (key_reg >> 19)) & ((1 << 80) - 1)
        # Step 2: S-box on top nibble (bits [79:76])
        top_nibble = (key_reg >> 76) & 0xF
        key_reg = (key_reg & ~(0xF << 76)) | (SBOX[top_nibble] << 76)
        # Step 3: XOR round_counter into bits [19:15]
        key_reg ^= (round_counter & 0x1F) << 15
        return key_reg

    # FSM states
    IDLE = 0
    ENCRYPT = 1
    DONE = 2

    # State variables
    fsm_state = IDLE
    key_reg = 0
    state = 0
    load_counter = 0
    round_counter = 0
    unload_counter = 0
    done = 0

    out = []

    for cyc in stim:
        rst_n = cyc.get("rst_n", 1)
        load_en = cyc.get("load_en", 0)
        din = cyc.get("din", 0)
        shift_out_en = cyc.get("shift_out_en", 0)

        if rst_n == 0:
            # Async reset
            fsm_state = IDLE
            key_reg = 0
            state = 0
            load_counter = 0
            round_counter = 0
            unload_counter = 0
            done = 0
            out.append({"dout": 0, "done": 0})
            continue

        # Normal cycle update
        dout = 0

        if fsm_state == IDLE or fsm_state == DONE:
            if fsm_state == DONE and load_en:
                # New load clears done and restarts
                done = 0
                fsm_state = IDLE
                load_counter = 0
                unload_counter = 0
                # Fall through to load logic below
                # Shift in din
                combined = ((key_reg << 64) | state) & ((1 << 144) - 1)
                combined = ((combined << 1) | din) & ((1 << 144) - 1)
                key_reg = (combined >> 64) & ((1 << 80) - 1)
                state = combined & ((1 << 64) - 1)
                load_counter = 1
                if load_counter == 144:
                    fsm_state = ENCRYPT
                    round_counter = 1
            elif fsm_state == DONE:
                # done asserted, check shift_out_en
                if shift_out_en:
                    dout = (state >> 63) & 1
                    state = (state << 1) & ((1 << 64) - 1)
                    unload_counter = (unload_counter + 1) & 0x3F
            elif fsm_state == IDLE:
                if load_en:
                    combined = ((key_reg << 64) | state) & ((1 << 144) - 1)
                    combined = ((combined << 1) | din) & ((1 << 144) - 1)
                    key_reg = (combined >> 64) & ((1 << 80) - 1)
                    state = combined & ((1 << 64) - 1)
                    load_counter += 1
                    if load_counter == 144:
                        fsm_state = ENCRYPT
                        round_counter = 1

        elif fsm_state == ENCRYPT:
            if round_counter <= 31:
                # Full round: addRoundKey, sBoxLayer, pLayer, key schedule
                round_key = (key_reg >> 16) & ((1 << 64) - 1)
                state ^= round_key
                state = sbox_layer(state)
                state = player(state)
                key_reg = key_schedule(key_reg, round_counter)
                round_counter += 1
                if round_counter == 32:
                    # Next cycle will be the final addRoundKey
                    pass
            else:
                # round_counter == 32: final addRoundKey only
                round_key = (key_reg >> 16) & ((1 << 64) - 1)
                state ^= round_key
                done = 1
                fsm_state = DONE
                unload_counter = 0

        out.append({"dout": dout, "done": done})

    return out
