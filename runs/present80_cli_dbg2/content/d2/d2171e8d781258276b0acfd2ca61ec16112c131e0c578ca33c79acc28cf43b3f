# rationale: Implement PRESENT-80 block cipher reference model with serial load/unload, FSM control, and full round computation.
# rationale: S-box = [0xC,0x5,0x6,0xB,0x9,0x0,0xA,0xD,0x3,0xE,0xF,0x8,0x4,0x7,0x1,0x2]
# rationale: pLayer: bit i of input goes to position P(i)=(i*16)%63 for i=0..62, P(63)=63
# rationale: Key schedule: rotate left 61 bits, S-box top nibble, XOR round counter into bits [19:15]
# rationale: Load phase: 144 bits MSB-first into {key_reg[79:0], state[63:0]}, auto-start encrypt on 144th bit
# rationale: Encrypt: 31 full rounds + 1 final addRoundKey = 32 cycles total
# rationale: Done phase: shift out ciphertext MSB-first when shift_out_en high

SBOX = [0xC, 0x5, 0x6, 0xB, 0x9, 0x0, 0xA, 0xD, 0x3, 0xE, 0xF, 0x8, 0x4, 0x7, 0x1, 0x2]

def _sbox_layer(state64):
    result = 0
    for nibble_idx in range(16):
        shift = nibble_idx * 4
        nibble = (state64 >> shift) & 0xF
        result |= SBOX[nibble] << shift
    return result

def _player(state64):
    result = 0
    for i in range(63):
        bit = (state64 >> i) & 1
        dest = (i * 16) % 63
        result |= bit << dest
    # bit 63 stays at 63
    bit63 = (state64 >> 63) & 1
    result |= bit63 << 63
    return result

def _key_schedule(key80, round_counter):
    # Rotate left by 61 bits (80-bit key)
    key80 = ((key80 << 61) | (key80 >> 19)) & ((1 << 80) - 1)
    # S-box top nibble (bits [79:76])
    top_nibble = (key80 >> 76) & 0xF
    key80 = (key80 & ~(0xF << 76)) | (SBOX[top_nibble] << 76)
    # XOR round counter into bits [19:15]
    key80 ^= (round_counter & 0x1F) << 15
    return key80

# FSM states
IDLE    = 0
LOAD    = 1
ENCRYPT = 2
DONE    = 3

def reference(stim: list[dict]) -> list[dict]:
    fsm_state = IDLE
    key_reg = 0
    state = 0
    load_bit_counter = 0
    round_counter = 0
    done = 0
    dout = 0
    # Combined shift register is 144 bits: key_reg[79:0] in upper 80, state[63:0] in lower 64
    shift_reg = 0  # 144-bit combined register during load

    out = []

    for cyc in stim:
        rst_n       = cyc.get("rst_n", 1)
        load_en     = cyc.get("load_en", 0)
        din         = cyc.get("din", 0)
        shift_out_en = cyc.get("shift_out_en", 0)

        if rst_n == 0:
            # Asynchronous reset
            fsm_state = IDLE
            load_bit_counter = 0
            round_counter = 0
            done = 0
            dout = 0
            shift_reg = 0
            key_reg = 0
            state = 0
            out.append({"done": done, "dout": dout})
            continue

        # Synchronous logic
        if fsm_state == IDLE:
            if load_en == 1:
                # Start loading
                fsm_state = LOAD
                shift_reg = (0 << 1) | din  # first bit
                load_bit_counter = 1
                done = 0
            # else stay idle
            dout = 0

        elif fsm_state == LOAD:
            if load_en == 1:
                # Shift in din
                shift_reg = ((shift_reg << 1) | din) & ((1 << 144) - 1)
                load_bit_counter += 1
                if load_bit_counter == 144:
                    # Extract key and state from shift register
                    # First 80 bits received are key (MSB first), next 64 bits are plaintext
                    # After 144 shifts left with din at LSB:
                    # shift_reg[143:64] = key_reg, shift_reg[63:0] = state
                    key_reg = (shift_reg >> 64) & ((1 << 80) - 1)
                    state   = shift_reg & ((1 << 64) - 1)
                    # Auto-start encryption: begin round 1 on this same cycle
                    fsm_state = ENCRYPT
                    round_counter = 1
                    # Execute round 1: addRoundKey, sBoxLayer, pLayer, key schedule
                    state = state ^ (key_reg >> 16)  # XOR with key_reg[79:16]
                    state = _sbox_layer(state)
                    state = _player(state)
                    key_reg = _key_schedule(key_reg, round_counter)
                    round_counter += 1
                    # round_counter is now 2, meaning we've completed round 1
            else:
                # load_en deasserted during load - stay in LOAD, freeze counter
                pass
            dout = 0

        elif fsm_state == ENCRYPT:
            if load_en == 1:
                # Abort encryption, restart load
                fsm_state = LOAD
                shift_reg = din & 1
                load_bit_counter = 1
                done = 0
                dout = 0
            else:
                # round_counter tracks which round we are about to execute
                # We've already done round 1 during the load transition
                # round_counter starts at 2 here
                if round_counter <= 31:
                    # Full round: addRoundKey, sBoxLayer, pLayer, key schedule
                    state = state ^ (key_reg >> 16)
                    state = _sbox_layer(state)
                    state = _player(state)
                    key_reg = _key_schedule(key_reg, round_counter)
                    round_counter += 1
                else:
                    # round_counter == 32: final addRoundKey only
                    state = state ^ (key_reg >> 16)
                    done = 1
                    fsm_state = DONE
                dout = 0

        elif fsm_state == DONE:
            if load_en == 1:
                # New load: clear done, restart
                done = 0
                fsm_state = LOAD
                shift_reg = din & 1
                load_bit_counter = 1
                dout = 0
            elif shift_out_en == 1:
                # Output MSB of state
                dout = (state >> 63) & 1
                state = (state << 1) & ((1 << 64) - 1)
            else:
                dout = 0

        out.append({"done": done, "dout": dout})

    return out
