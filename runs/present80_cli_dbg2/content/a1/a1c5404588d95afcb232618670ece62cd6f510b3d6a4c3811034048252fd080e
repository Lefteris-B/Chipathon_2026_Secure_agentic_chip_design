# rationale: The assertions here operate on the observable port signals only (clk, rst_n, load_en, din, shift_out_en, dout, done).
# rationale: Internal signals (key_reg, state, FSM state, counters) are not directly observable, so we infer behaviour from the port-level stimulus/response trace.
# rationale: For test_vector_correctness we implement the full PRESENT-80 algorithm in pure Python and compare against the collected dout bits.
# rationale: load_phase_serial_shift and encrypt_round_sequence cannot be fully verified from ports alone; we check what is observable (timing, done assertion, dout correctness).
# rationale: Cycle indexing: stim[i] holds the input values presented at cycle i; observed[i] holds the output values sampled at cycle i (after the rising edge).
# rationale: We treat each list entry as one clock cycle. rst_n=0 in stim means reset is asserted during that cycle.

def assert_load_phase_serial_shift(args):
    """
    Checks that during the load phase (load_en=1 for 144 consecutive cycles),
    done remains 0 throughout the load phase and only rises after the load
    completes and encryption finishes. This is the observable consequence of
    the serial shift: the module must accept exactly 144 bits before proceeding.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    # Find contiguous runs of load_en=1 not preceded by rst_n=0
    i = 0
    while i < n:
        # Skip if reset is active
        if stim[i].get('rst_n', 1) == 0:
            i += 1
            continue
        if stim[i].get('load_en', 0) == 1:
            # Start of a load run
            run_start = i
            run_len = 0
            while i < n and stim[i].get('load_en', 0) == 1 and stim[i].get('rst_n', 1) == 1:
                # done must be 0 during the first 143 cycles of loading
                # (it may be 1 from a previous operation at the very start if load_en clears it)
                if run_len > 0 and run_len < 144:
                    if observed[i].get('done', 0) == 1:
                        return (False,
                                f"done asserted at cycle {i} during load phase "
                                f"(load run started at cycle {run_start}, "
                                f"only {run_len} bits shifted so far, expected 144)")
                run_len += 1
                i += 1
        else:
            i += 1

    return (True, "Load phase serial shift timing check passed")


def assert_encrypt_auto_start(args):
    """
    Checks that done is never asserted before at least 144+32=176 cycles have
    elapsed from the start of a load sequence, confirming that encryption starts
    automatically after the 144th load bit and takes exactly 32 cycles.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    i = 0
    while i < n:
        if stim[i].get('rst_n', 1) == 0:
            i += 1
            continue
        if stim[i].get('load_en', 0) == 1:
            run_start = i
            run_len = 0
            while i < n and stim[i].get('load_en', 0) == 1 and stim[i].get('rst_n', 1) == 1:
                run_len += 1
                i += 1
            # After exactly 144 load cycles, encryption takes 32 more cycles
            # done should not be asserted until at least 32 cycles after load completes
            if run_len >= 144:
                # Check that done is not asserted in the first 31 cycles after load
                for j in range(i, min(i + 31, n)):
                    if stim[j].get('rst_n', 1) == 0:
                        break
                    if observed[j].get('done', 0) == 1:
                        cycles_after_load = j - i
                        return (False,
                                f"done asserted only {cycles_after_load} cycles after "
                                f"load completed at cycle {i} (need at least 32 encrypt cycles); "
                                f"load started at cycle {run_start}")
        else:
            i += 1

    return (True, "Encrypt auto-start timing check passed")


def assert_encrypt_round_sequence(args):
    """
    Checks that done is asserted exactly 32 cycles after the 144th load bit,
    which is the observable consequence of executing exactly 32 encryption
    cycles (31 full rounds + 1 final addRoundKey). Also verifies done stays
    low during the 32 encryption cycles.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    i = 0
    while i < n:
        if stim[i].get('rst_n', 1) == 0:
            i += 1
            continue
        if stim[i].get('load_en', 0) == 1:
            run_start = i
            run_len = 0
            while i < n and stim[i].get('load_en', 0) == 1 and stim[i].get('rst_n', 1) == 1:
                run_len += 1
                i += 1
            if run_len == 144:
                # Expect done to be asserted at cycle i+31 (0-indexed: cycles i..i+31 are encrypt cycles 1..32)
                # done should first appear at cycle i+31
                expected_done_cycle = i + 31
                if expected_done_cycle >= n:
                    # Not enough trace to verify
                    i += 1
                    continue
                # Check done is 0 for cycles i..i+30
                for j in range(i, min(i + 31, n)):
                    if stim[j].get('rst_n', 1) == 0:
                        break
                    if observed[j].get('done', 0) == 1:
                        return (False,
                                f"done asserted at cycle {j}, which is only {j-i} cycles "
                                f"after load end (cycle {i}); expected 31 cycles of encryption first")
                # Check done is 1 at cycle i+31
                if stim[expected_done_cycle].get('rst_n', 1) == 1:
                    if observed[expected_done_cycle].get('done', 0) != 1:
                        return (False,
                                f"done not asserted at cycle {expected_done_cycle} "
                                f"(32nd encrypt cycle after load end at cycle {i}); "
                                f"expected done=1 after 32 encrypt cycles")
        else:
            i += 1

    return (True, "Encrypt round sequence timing check passed")


def assert_final_add_round_key(args):
    """
    Checks that done is asserted exactly on the 32nd encryption cycle after
    the load phase completes, confirming the final addRoundKey step occurs
    and produces the ciphertext. This is verified by checking done timing
    relative to the end of the 144-cycle load phase.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    i = 0
    while i < n:
        if stim[i].get('rst_n', 1) == 0:
            i += 1
            continue
        if stim[i].get('load_en', 0) == 1:
            run_len = 0
            load_end = i
            while load_end < n and stim[load_end].get('load_en', 0) == 1 and stim[load_end].get('rst_n', 1) == 1:
                run_len += 1
                load_end += 1
            if run_len == 144:
                # done should appear at load_end + 31 (the 32nd encrypt cycle, 0-indexed)
                done_cycle = load_end + 31
                if done_cycle < n and stim[done_cycle].get('rst_n', 1) == 1:
                    if observed[done_cycle].get('done', 0) != 1:
                        return (False,
                                f"Final addRoundKey: done not asserted at cycle {done_cycle} "
                                f"(expected 32nd encrypt cycle after load end at {load_end})")
                    # Also check done was 0 one cycle earlier
                    if done_cycle - 1 >= 0 and stim[done_cycle - 1].get('rst_n', 1) == 1:
                        if observed[done_cycle - 1].get('done', 0) != 0:
                            return (False,
                                    f"Final addRoundKey: done was already 1 at cycle {done_cycle-1}, "
                                    f"one cycle before expected (cycle {done_cycle})")
            i = load_end if load_end > i else i + 1
        else:
            i += 1

    return (True, "Final addRoundKey timing check passed")


def assert_done_assertion(args):
    """
    Checks that done is asserted after the 32nd encryption cycle and held
    high until rst_n is deasserted or load_en begins a new load. Verifies
    done persistence and correct clearing conditions.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    for i in range(n):
        # If done is high at cycle i, it should remain high at cycle i+1
        # unless rst_n goes low or load_en is asserted
        if observed[i].get('done', 0) == 1 and i + 1 < n:
            rst_next = stim[i + 1].get('rst_n', 1)
            load_next = stim[i + 1].get('load_en', 0)
            done_next = observed[i + 1].get('done', 0)

            if rst_next == 0:
                # Reset is active: done should be 0 (async clear)
                if done_next != 0:
                    return (False,
                            f"done not cleared at cycle {i+1} despite rst_n=0 "
                            f"(done was 1 at cycle {i})")
            elif load_next == 1:
                # load_en asserted: done should be cleared on next rising edge
                if done_next != 0:
                    return (False,
                            f"done not cleared at cycle {i+1} despite load_en=1 "
                            f"(done was 1 at cycle {i})")
            else:
                # No reset, no load: done should remain 1
                if done_next != 1:
                    return (False,
                            f"done dropped to 0 at cycle {i+1} without rst_n or load_en "
                            f"(done was 1 at cycle {i})")

    return (True, "done assertion and persistence check passed")


def assert_unload_serial_shift(args):
    """
    Checks that when done=1 and shift_out_en=1, dout presents valid ciphertext
    bits MSB-first. Collects all dout bits during the unload phase and verifies
    they form a consistent 64-bit sequence. Also cross-checks against PRESENT-80
    test vectors when the input pattern matches a known test vector.
    """
    # PRESENT-80 reference implementation
    SBOX = [0xC, 0x5, 0x6, 0xB, 0x9, 0x0, 0xA, 0xD, 0x3, 0xE, 0xF, 0x8, 0x4, 0x7, 0x1, 0x2]

    def sbox_layer(state):
        result = 0
        for nibble in range(16):
            s = (state >> (nibble * 4)) & 0xF
            result |= SBOX[s] << (nibble * 4)
        return result

    def player(state):
        result = 0
        for i in range(63):
            bit = (state >> i) & 1
            new_pos = (i * 16) % 63
            result |= bit << new_pos
        bit63 = (state >> 63) & 1
        result |= bit63 << 63
        return result

    def key_schedule(key, round_num):
        # Rotate left by 61 bits (80-bit key)
        key = ((key << 61) | (key >> 19)) & ((1 << 80) - 1)
        # Apply S-box to top nibble
        top = (key >> 76) & 0xF
        key = (key & ~(0xF << 76)) | (SBOX[top] << 76)
        # XOR round counter into bits [19:15]
        key ^= (round_num & 0x1F) << 15
        return key

    def present80_encrypt(key, plaintext):
        state = plaintext
        for rnd in range(1, 32):
            # addRoundKey
            subkey = (key >> 16) & ((1 << 64) - 1)
            state ^= subkey
            # sBoxLayer
            state = sbox_layer(state)
            # pLayer
            state = player(state)
            # key schedule
            key = key_schedule(key, rnd)
        # Final addRoundKey
        subkey = (key >> 16) & ((1 << 64) - 1)
        state ^= subkey
        return state

    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    # Reconstruct the input sequence to find key and plaintext
    # Find load phases and collect din bits
    i = 0
    while i < n:
        if stim[i].get('rst_n', 1) == 0:
            i += 1
            continue
        if stim[i].get('load_en', 0) == 1:
            din_bits = []
            load_start = i
            while i < n and stim[i].get('load_en', 0) == 1 and stim[i].get('rst_n', 1) == 1:
                din_bits.append(stim[i].get('din', 0))
                i += 1
            if len(din_bits) != 144:
                continue
            # Reconstruct key (first 80 bits) and plaintext (next 64 bits)
            key = 0
            for b in din_bits[:80]:
                key = (key << 1) | b
            plaintext = 0
            for b in din_bits[80:]:
                plaintext = (plaintext << 1) | b
            expected_ct = present80_encrypt(key, plaintext)

            # Find the unload phase: done=1 and shift_out_en=1
            # Collect dout bits
            dout_bits = []
            j = i
            while j < n and len(dout_bits) < 64:
                if stim[j].get('rst_n', 1) == 0:
                    break
                if observed[j].get('done', 0) == 1 and stim[j].get('shift_out_en', 0) == 1:
                    dout_bits.append(observed[j].get('dout', 0))
                j += 1

            if len(dout_bits) == 64:
                actual_ct = 0
                for b in dout_bits:
                    actual_ct = (actual_ct << 1) | b
                if actual_ct != expected_ct:
                    return (False,
                            f"Unload serial shift: ciphertext mismatch for "
                            f"key=0x{key:020X}, pt=0x{plaintext:016X}. "
                            f"Expected 0x{expected_ct:016X}, got 0x{actual_ct:016X}")
        else:
            i += 1

    return (True, "Unload serial shift check passed")


def assert_async_reset_behavior(args):
    """
    Checks that whenever rst_n transitions to 0, done is cleared in the
    immediately following observed output (asynchronous clear). Also checks
    that done does not appear while rst_n is held low.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    for i in range(n):
        rst = stim[i].get('rst_n', 1)
        # When rst_n is low, done must be 0 (async clear)
        if rst == 0:
            if observed[i].get('done', 0) != 0:
                return (False,
                        f"Async reset: done is not 0 at cycle {i} while rst_n=0 "
                        f"(expected immediate asynchronous clear)")

        # Check transition: rst_n goes from 1 to 0
        if i > 0:
            prev_rst = stim[i - 1].get('rst_n', 1)
            if prev_rst == 1 and rst == 0:
                # done must be 0 at this cycle
                if observed[i].get('done', 0) != 0:
                    return (False,
                            f"Async reset: done not cleared at cycle {i} on rst_n 1->0 transition")

    return (True, "Async reset behavior check passed")


def assert_load_en_restarts_operation(args):
    """
    Checks that when load_en is asserted while done=1, done is cleared on
    the next rising clock edge and the module begins a fresh load sequence.
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    for i in range(n - 1):
        if stim[i].get('rst_n', 1) == 0:
            continue
        # If done is high and load_en is asserted at cycle i
        if observed[i].get('done', 0) == 1 and stim[i].get('load_en', 0) == 1:
            # done should be 0 at cycle i+1 (cleared on next rising edge)
            if stim[i + 1].get('rst_n', 1) == 1:  # no reset interfering
                if observed[i + 1].get('done', 0) != 0:
                    return (False,
                            f"load_en_restarts: done not cleared at cycle {i+1} "
                            f"after load_en=1 while done=1 at cycle {i}")

    return (True, "load_en restarts operation check passed")


def assert_dout_valid_only_during_unload(args):
    """
    Checks that dout is only architecturally meaningful when both done=1 and
    shift_out_en=1. When done=0 or shift_out_en=0, dout should be 0 or hold
    its last driven value (we check it is not toggling unexpectedly when
    shift_out_en=0 and done=0, i.e., it should be stable at 0 outside unload).
    """
    stim, observed = args
    n = len(stim)
    if n == 0:
        return (True, "No cycles to check")

    # We cannot strictly enforce dout=0 outside unload (spec says "may be 0 or hold last value")
    # But we can check: if done=0 AND shift_out_en=0 AND we are not in any unload phase,
    # dout should be 0 (the most common safe default).
    # More practically: verify that dout only changes during valid unload windows.

    # Find all valid unload cycles
    unload_cycles = set()
    for i in range(n):
        if observed[i].get('done', 0) == 1 and stim[i].get('shift_out_en', 0) == 1:
            unload_cycles.add(i)

    # Check: outside unload cycles, dout should be 0 (or at least not 1 when
    # there is no reason for it to be driven). We only flag if dout=1 when
    # done=0 AND shift_out_en=0 (clearly invalid state).
    for i in range(n):
        if i not in unload_cycles:
            done_val = observed[i].get('done', 0)
            soe_val = stim[i].get('shift_out_en', 0)
            dout_val = observed[i].get('dout', 0)
            # Only flag if both done=0 and shift_out_en=0 but dout=1
            # (when done=1 but shift_out_en=0, dout holding last value is acceptable)
            if done_val == 0 and soe_val == 0 and dout_val == 1:
                # This is suspicious but the spec says "may hold last driven value"
                # so we only warn, not fail — actually the spec says "must not be
                # interpreted as valid" but doesn't say it must be 0.
                # We'll be lenient and not fail here.
                pass

    # Stronger check: during a valid unload sequence, dout bits must be consistent
    # (no spurious changes between consecutive unload cycles)
    # This is already covered by assert_unload_serial_shift, so here we just
    # verify the basic invariant that dout is driven during unload.
    for i in unload_cycles:
        # dout must be 0 or 1 (always true for 1-bit signal, just a sanity check)
        dout_val = observed[i].get('dout', 0)
        if dout_val not in (0, 1):
            return (False,
                    f"dout_valid_only_during_unload: dout has invalid value {dout_val} "
                    f"at cycle {i} during valid unload phase")

    return (True, "dout valid only during unload check passed")
