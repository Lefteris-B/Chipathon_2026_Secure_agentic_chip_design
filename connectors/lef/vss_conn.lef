VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO vss_conn
  CLASS BLOCK ;
  FOREIGN vss_conn ;
  ORIGIN 0.000 0.000 ;
  SIZE 30.000 BY 72.280 ;
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal2 ;
        RECT 0.000 62.780 30.000 72.280 ;
        RECT 0.000 49.630 30.000 59.880 ;
        RECT 0.000 37.780 30.000 48.030 ;
        RECT 0.000 24.250 30.000 34.500 ;
        RECT 0.000 12.400 30.000 22.650 ;
        RECT 0.000 0.000 30.000 9.500 ;
      LAYER Metal3 ;
        RECT 0.000 62.780 30.000 72.280 ;
        RECT 0.000 49.630 30.000 59.880 ;
        RECT 0.000 37.780 30.000 48.030 ;
        RECT 0.000 24.250 30.000 34.500 ;
        RECT 0.000 12.400 30.000 22.650 ;
        RECT 0.000 0.000 30.000 9.500 ;
    END
  END VSS
END vss_conn
END LIBRARY
