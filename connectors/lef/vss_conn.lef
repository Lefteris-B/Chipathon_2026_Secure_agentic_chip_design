VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO vss_conn
  CLASS BLOCK ;
  FOREIGN vss_conn ;
  ORIGIN 0.000 0.000 ;
  SIZE 10.000 BY 72.280 ;
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal2 ;
        RECT 0.000 62.780 10.000 72.280 ;
        RECT 0.000 49.630 10.000 59.880 ;
        RECT 0.000 37.780 10.000 48.030 ;
        RECT 0.000 24.250 10.000 34.500 ;
        RECT 0.000 12.400 10.000 22.650 ;
        RECT 0.000 0.000 10.000 9.500 ;
      LAYER Metal5 ;
        RECT 0.000 62.780 10.000 72.280 ;
        RECT 0.000 49.630 10.000 59.880 ;
        RECT 0.000 37.780 10.000 48.030 ;
        RECT 0.000 24.250 10.000 34.500 ;
        RECT 0.000 12.400 10.000 22.650 ;
        RECT 0.000 0.000 10.000 9.500 ;
    END
  END VSS
  OBS
      LAYER Metal3 ;
        RECT 0.000 0.000 10.000 72.280 ;
      LAYER Metal4 ;
        RECT 0.000 0.000 10.000 72.280 ;
  END
END vss_conn
END LIBRARY
