# rationale: Implement PRESENT-80 block cipher reference model with bit-serial I/O
# rationale: SBOX constant 64'h21748FE3DA09B65C means nibble index x -> SBOX[4*x+:4]
# rationale: The hex string 21748FE3DA09B65C encodes 16 nibbles; nibble 0 is LSB side
# rationale: pLayer: P(i) = (i*16) mod 63 for i=0..62, P(63)=63
# rationale: Key schedule: rotate left 61, S-box top nibble, XOR round into bits [19:15]
# rationale: FSM states: LOAD=0, ENCRYPT=1, DONE=2
# rationale: Final addRoundKey happens on a separate edge after round 31 key schedule

def reference(stim: list[dict]) -> list[dict]:
    # SBOX: 64'h21748FE3DA09B65C
    # This is a 64-bit hex value. Nibble index x (0..15) maps to SBOX[4*x +: 4]
    # i.e., nibble 0 is bits [3:0], nibble 15 is bits [63:60]
    SBOX_VAL = 0x21748FE3DA09B65C
    SBOX = [(SBOX_VAL >> (4 * x)) & 0xF for x in range(16)]
    # SBOX[0]=C, SBOX[1]=5, SBOX[2]=6, SBOX[3]=B, SBOX[4]=9, SBOX[5]=0, SBOX[6]=A, SBOX[7]=D,
    # SBOX[8]=3, SBOX[9]=E, SBOX[10]=F, SBOX[11]=8, SBOX[12]=4, SBOX[13]=7, SBOX[14]=2, SBOX[15]=1

    def sbox_layer(state64):
        result = 0
        for nibble_pos in range(16):
            nibble_val = (state64 >> (4 * nibble_pos)) & 0xF
            result |= SBOX[nibble_val] << (4 * nibble_pos)
        return result

    def player(state64):
        result = 0
        for i in range(63):
            bit = (state64 >> i) & 1
            p = (i * 16) % 63
            result |= bit << p
        # P(63) = 63
        bit63 = (state64 >> 63) & 1
        result |= bit63 << 63
        return result

    def key_schedule(key80, round_cnt):
        # Step 1: rotate left 61 bits (80-bit)
        key80 = ((key80 << 61) | (key80 >> 19)) & ((1 << 80) - 1)
        # Step 2: apply S-box to top nibble (bits [79:76])
        top_nibble = (key80 >> 76) & 0xF
        sub_nibble = SBOX[top_nibble]
        key80 = (key80 & ~(0xF << 76)) | (sub_nibble << 76)
        # Step 3: XOR round counter into bits [19:15]
        key80 ^= (round_cnt & 0x1F) << 15
        return key80

    # FSM states
    LOAD = 0
    ENCRYPT = 1
    DONE = 2

    # State variables
    fsm_state = LOAD
    key_reg = 0   # 80-bit
    state = 0     # 64-bit
    load_cnt = 0  # 0..144
    round_cnt = 0 # 1..31
    done = 0
    unload_cnt = 0

    # ENCRYPT sub-state: after 31 rounds, need one more edge for final addRoundKey
    # We track this with round_cnt: rounds 1..31 do full round, round_cnt=32 means final addRoundKey
    # Actually per contract: after round 31 key schedule, next edge does final addRoundKey
    # So in ENCRYPT state: if round_cnt <= 31, do full round; if round_cnt == 32, do final addRoundKey

    out = []

    for cyc in stim:
        rst_n = cyc.get("rst_n", 1)
        load_en = cyc.get("load_en", 0)
        din = cyc.get("din", 0)
        shift_out_en = cyc.get("shift_out_en", 0)

        if rst_n == 0:
            # Asynchronous reset
            fsm_state = LOAD
            key_reg = 0
            state = 0
            load_cnt = 0
            round_cnt = 0
            done = 0
            unload_cnt = 0
            out.append({"dout": 0, "done": 0})
            continue

        # Normal clock edge processing
        if fsm_state == LOAD:
            if load_en:
                # Shift {key_reg[79:0], state[63:0]} left by 1, insert din at bit 0
                # Combined 144-bit register: key_reg is upper 80 bits, state is lower 64 bits
                combined = (key_reg << 64) | state
                combined = ((combined << 1) | din) & ((1 << 144) - 1)
                key_reg = (combined >> 64) & ((1 << 80) - 1)
                state = combined & ((1 << 64) - 1)
                load_cnt += 1
                if load_cnt == 144:
                    fsm_state = ENCRYPT
                    round_cnt = 1
            out.append({"dout": 0, "done": 0})

        elif fsm_state == ENCRYPT:
            if round_cnt <= 31:
                # Full round: addRoundKey, sBoxLayer, pLayer, key schedule
                # addRoundKey: XOR state with key_reg[79:16]
                round_key = (key_reg >> 16) & ((1 << 64) - 1)
                state ^= round_key
                # sBoxLayer
                state = sbox_layer(state)
                # pLayer
                state = player(state)
                # key schedule update
                key_reg = key_schedule(key_reg, round_cnt)
                round_cnt += 1
                if round_cnt == 32:
                    # Next edge will do final addRoundKey
                    pass
                out.append({"dout": 0, "done": 0})
            else:
                # round_cnt == 32: final addRoundKey
                round_key = (key_reg >> 16) & ((1 << 64) - 1)
                state ^= round_key
                done = 1
                fsm_state = DONE
                out.append({"dout": 0, "done": 1})

        elif fsm_state == DONE:
            # Check load_en first (takes priority)
            if load_en:
                # Clear done, return to LOAD, start new load
                done = 0
                fsm_state = LOAD
                load_cnt = 0
                round_cnt = 0
                # Also shift in this bit
                combined = (key_reg << 64) | state
                combined = ((combined << 1) | din) & ((1 << 144) - 1)
                key_reg = (combined >> 64) & ((1 << 80) - 1)
                state = combined & ((1 << 64) - 1)
                load_cnt = 1
                out.append({"dout": 0, "done": 0})
            elif shift_out_en:
                # Output state[63], shift state left
                dout_val = (state >> 63) & 1
                state = (state << 1) & ((1 << 64) - 1)
                unload_cnt = (unload_cnt + 1) & 0x3F
                out.append({"dout": dout_val, "done": 1})
            else:
                out.append({"dout": 0, "done": 1})

    return out
