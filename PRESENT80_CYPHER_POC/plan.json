  "top_module_id": "mod_present80",
  "modules": [
    {
      "module_id": "mod_present80",
      "name": "present80",
      "description": "PRESENT-80 block cipher encryption core; iterative, one round per clock, 32-cycle latency from start to done",
      "ports": [
        {
          "name": "clk",
          "direction": "in",
          "width": 1,
          "description": "Primary clock, 100 MHz"
        },
        {
          "name": "rst_n",
          "direction": "in",
          "width": 1,
          "description": "Asynchronous active-low reset, synchronous release"
        },
        {
          "name": "start",
          "direction": "in",
          "width": 1,
          "description": "Single-cycle pulse: latches plaintext and key, begins encryption"
        },
        {
          "name": "plaintext",
          "direction": "in",
          "width": 64,
          "description": "64-bit plaintext block to encrypt"
        },
        {
          "name": "key",
          "direction": "in",
          "width": 80,
          "description": "80-bit encryption key"
        },
        {
          "name": "ciphertext",
          "direction": "out",
          "width": 64,
          "description": "64-bit ciphertext; valid when done is high"
        },
        {
          "name": "done",
          "direction": "out",
          "width": 1,
          "description": "Asserted for exactly one cycle when ciphertext is valid"
        }
      ],
      "params": {
        "BLOCK_WIDTH": 64,
        "CLK_PERIOD_NS": 10,
        "KEY_WIDTH": 80,
        "ROUNDS": 31
      },
      "depends_on": []
    }
  ],
  "rationale": "Spec mandates a single flat Verilog module with no sub-modules. The design contains an FSM (IDLE, ROUND, DONE states), a 64-bit state register, an 80-bit key register, a 5-bit round counter, combinational addRoundKey/sBoxLayer/pLayer datapaths, and a combinational key-schedule update, all clocked on the single clk domain with asynchronous-assert/synchronous-release rst_n."
}